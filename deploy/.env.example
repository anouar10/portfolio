# Copy to .env and fill in.  Never commit .env.

# ---- the image the server pulls --------------------------------------------
# Your DOCKER HUB namespace, not your GitHub one. This must match the tags
# in .github/workflows/deploy.yml exactly.
IMAGE=YOUR_DOCKERHUB_USERNAME/portfolio
TAG=latest

# ---- domain ----------------------------------------------------------------
# Bare domain, no scheme, no trailing slash. Both this and www. must have
# A records pointing at this server before you start the prod stack, or
# Let's Encrypt will fail the HTTP challenge.
DOMAIN=example.com
ACME_EMAIL=you@example.com

# ---- analytics (only needed if you run the umami services) -----------------
# setup-server.sh generates these. Do not reuse across environments.
DB_PASSWORD=
APP_SECRET=
